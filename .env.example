DATABASE_URL="postgresql://myuser:mypassword@localhost:5432/mydb?schema=public"

# Email provider driver: "ses" or "fake"
EMAIL_PROVIDER_DRIVER=fake

# Required when EMAIL_PROVIDER_DRIVER=ses
AWS_REGION=us-east-2
AWS_SES_FROM_ADDRESS=noreply@yourdomain.com
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_SES_CONFIGURATION_SET=my-first-configuration-set

# Integration testing
RUN_SES_INTEGRATION_TESTS=false
AWS_SES_TEST_RECIPIENT=test@example.com

# Tracking pixel & click redirect
TRACKING_SECRET=change-me-use-a-long-random-string
APP_BASE_URL=http://localhost:3000
TRACKING_ALLOWED_DOMAINS=yourdomain.com,digireps.co

# Analytics aggregation cron schedule (default: every 15 minutes)
# Standard 5-field cron expression. Changing this requires a process restart.
ANALYTICS_CRON=*/15 * * * *
