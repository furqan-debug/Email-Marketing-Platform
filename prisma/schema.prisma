generator client {
  provider     = "prisma-client"
  output       = "./generated/client"
  moduleFormat = "cjs"
}

 datasource db {
  provider = "postgresql"
}

 model Workspace {
   id           String        @id @default(uuid())
   name         String
   audiences    Audience[]
   suppressions Suppression[]
 }

 model Audience {
   id          String     @id @default(uuid())
   name        String
   workspaceId String
   workspace   Workspace  @relation(fields: [workspaceId], references: [id])
   contacts    Contact[]
   campaigns   Campaign[]
 }

 model Contact {
  id                 String              @id @default(uuid())
  email              String
  firstName          String?
  lastName           String?
  attributes         Json?               // arbitrary custom key-value attributes from CSV
  audienceId         String
  audience           Audience            @relation(fields: [audienceId], references: [id])
  messages           Message[]
  leads              CampaignLead[]
  workflowExecutions WorkflowExecution[]

  @@unique([audienceId, email])
}

 model Campaign {
  id         String             @id @default(uuid())
  name       String
  subject    String?            // email subject line (defaults to name if blank)
  fromName   String?            // "Display Name" shown in inbox (e.g. "Digireps Team")
  fromEmail  String?            // custom sender email (e.g. "support@digireps.org")
  replyTo    String?            // optional reply-to address
  htmlBody   String?            // raw HTML body (used when templateId is null and isSequence is false)
  templateId String?            // optional: use a saved Template instead
  template   Template?          @relation(fields: [templateId], references: [id])
  status     String             @default("DRAFT")
  isSequence Boolean            @default(false)
  audienceId String
  audience   Audience           @relation(fields: [audienceId], references: [id])
  steps      CampaignStep[]
  leads      CampaignLead[]
  messages   Message[]
  snapshot   AnalyticsSnapshot?
}

model CampaignStep {
  id          String    @id @default(uuid())
  campaignId  String
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  stepOrder   Int       // 1, 2, 3...
  delayHours  Int       @default(48) // e.g. 48 hours (2 days) after previous step
  sendAsReply Boolean   @default(true) // Send in same thread (Re: Original Subject)
  subject     String?   // Used only if sendAsReply is false
  htmlBody    String    // Visual composer HTML with merge tags
  templateId  String?
  createdAt   DateTime  @default(now())

  @@unique([campaignId, stepOrder])
}

model CampaignLead {
  id            String    @id @default(uuid())
  campaignId    String
  contactId     String
  currentStep   Int       @default(1)
  status        String    @default("ACTIVE") // ACTIVE, WAITING_DELAY, COMPLETED, PAUSED, REPLIED, UNSUBSCRIBED, BOUNCED
  rootMessageId String?   // Original SES Message-ID from Step 1 (for In-Reply-To threading)
  lastSentAt    DateTime?
  nextSendAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  contact       Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  campaign      Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
  @@index([status, nextSendAt])
}

 model Message {
  id            String    @id @default(uuid())
  campaignId    String
  campaign      Campaign  @relation(fields: [campaignId], references: [id])
  contactId     String
  contact       Contact   @relation(fields: [contactId], references: [id])
  stepNumber    Int       @default(1)
  trackingToken String?   @unique
  enqueuedAt    DateTime?
  events        Event[]

  @@unique([campaignId, contactId, stepNumber])
}

 model Event {
   id          String   @id @default(uuid())
   type        String
   messageId   String
   message     Message  @relation(fields: [messageId], references: [id])
   rawPayload  Json
   country     String?
   occurredAt  DateTime @default(now())
 }

 model Suppression {
   id          String    @id @default(uuid())
   workspaceId String
   workspace   Workspace @relation(fields: [workspaceId], references: [id])
   email       String
   createdAt   DateTime  @default(now())

   @@unique([workspaceId, email])
 }

 model Template {
   id        String     @id @default(uuid())
   name      String
   subject   String?
   html      String
   campaigns Campaign[]
 }

 model AnalyticsSnapshot {
   id          String   @id @default(uuid())
   campaignId  String   @unique
   campaign    Campaign @relation(fields: [campaignId], references: [id])
   sent        Int      @default(0)
   delivered   Int      @default(0)
   opened      Int      @default(0)   // unique openers (COUNT DISTINCT messageId)
   clicked     Int      @default(0)   // unique clickers (COUNT DISTINCT messageId)
   totalOpens  Int      @default(0)   // raw total open events (same message can fire many)
   totalClicks Int      @default(0)   // raw total click events
   bounced     Int      @default(0)
   complained  Int      @default(0)
   computedAt  DateTime @default(now())
 }

 model WorkflowExecution {
   id           String   @id @default(uuid())
   workflowType String   @default("WELCOME_SERIES")
   contactId    String
   contact      Contact  @relation(fields: [contactId], references: [id])
   status       String   @default("RUNNING") // RUNNING, COMPLETED, CANCELLED
   currentStep  Int      @default(1)
   createdAt    DateTime @default(now())
   updatedAt    DateTime @updatedAt
 }

