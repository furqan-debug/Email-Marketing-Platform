generator client {
  provider     = "prisma-client"
  output       = "./generated/client"
  moduleFormat = "cjs"
}

 datasource db {
  provider = "postgresql"
}

 model Workspace {
   id           String        @id @default(uuid())
   name         String
   audiences    Audience[]
   suppressions Suppression[]
 }

 model Audience {
   id          String     @id @default(uuid())
   name        String
   workspaceId String
   workspace   Workspace  @relation(fields: [workspaceId], references: [id])
   contacts    Contact[]
   campaigns   Campaign[]
 }

 model Contact {
  id                 String              @id @default(uuid())
  email              String
  firstName          String?
  lastName           String?
  attributes         Json?               // arbitrary custom key-value attributes from CSV
  audienceId         String
  audience           Audience            @relation(fields: [audienceId], references: [id])
  messages           Message[]
  workflowExecutions WorkflowExecution[]

  @@unique([audienceId, email])
}

 model Campaign {
  id         String             @id @default(uuid())
  name       String
  subject    String?            // email subject line (defaults to name if blank)
  fromName   String?            // "Display Name" shown in inbox (e.g. "Digireps Team")
  fromEmail  String?            // custom sender email (e.g. "support@digireps.org")
  replyTo    String?            // optional reply-to address
  htmlBody   String?            // raw HTML body (used when templateId is null)
  templateId String?            // optional: use a saved Template instead
  template   Template?          @relation(fields: [templateId], references: [id])
  status     String             @default("DRAFT")
  audienceId String
  audience   Audience           @relation(fields: [audienceId], references: [id])
  messages   Message[]
  snapshot   AnalyticsSnapshot?
}

 model Message {
   id            String    @id @default(uuid())
   campaignId    String
   campaign      Campaign  @relation(fields: [campaignId], references: [id])
   contactId     String
   contact       Contact   @relation(fields: [contactId], references: [id])
   trackingToken String?   @unique
   enqueuedAt    DateTime?
   events        Event[]

   @@unique([campaignId, contactId])
 }

 model Event {
   id          String   @id @default(uuid())
   type        String
   messageId   String
   message     Message  @relation(fields: [messageId], references: [id])
   rawPayload  Json
   country     String?
   occurredAt  DateTime @default(now())
 }

 model Suppression {
   id          String    @id @default(uuid())
   workspaceId String
   workspace   Workspace @relation(fields: [workspaceId], references: [id])
   email       String
   createdAt   DateTime  @default(now())

   @@unique([workspaceId, email])
 }

 model Template {
   id        String     @id @default(uuid())
   name      String
   subject   String?
   html      String
   campaigns Campaign[]
 }

 model AnalyticsSnapshot {
   id          String   @id @default(uuid())
   campaignId  String   @unique
   campaign    Campaign @relation(fields: [campaignId], references: [id])
   sent        Int      @default(0)
   delivered   Int      @default(0)
   opened      Int      @default(0)   // unique openers (COUNT DISTINCT messageId)
   clicked     Int      @default(0)   // unique clickers (COUNT DISTINCT messageId)
   totalOpens  Int      @default(0)   // raw total open events (same message can fire many)
   totalClicks Int      @default(0)   // raw total click events
   bounced     Int      @default(0)
   complained  Int      @default(0)
   computedAt  DateTime @default(now())
 }

 model WorkflowExecution {
   id           String   @id @default(uuid())
   workflowType String   @default("WELCOME_SERIES")
   contactId    String
   contact      Contact  @relation(fields: [contactId], references: [id])
   status       String   @default("RUNNING") // RUNNING, COMPLETED, CANCELLED
   currentStep  Int      @default(1)
   createdAt    DateTime @default(now())
   updatedAt    DateTime @updatedAt
 }

